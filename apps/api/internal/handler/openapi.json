{
  "openapi": "3.1.0",
  "info": {
    "title": "여행 공유 API",
    "version": "2.2.0",
    "description": "전 세계 여행 계획, 장소 검색, 날짜별 체크리스트와 공유 기능을 제공하는 Map Planner API"
  },
  "servers": [
    { "url": "http://localhost:8080", "description": "로컬 개발" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "map_planner_session",
        "description": "브라우저 로그인 시 발급되는 HttpOnly 세션 쿠키"
      }
    },
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "required": ["email", "password", "code"],
        "properties": {
          "email": { "type": "string", "example": "user@example.com" },
          "password": { "type": "string", "minLength": 8, "example": "Strong1!Password" },
          "code": { "type": "string", "pattern": "^[0-9]{6}$", "example": "123456" }
        }
      },
      "SendVerificationCodeRequest": {
        "type": "object",
        "required": ["email", "purpose"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "purpose": { "type": "string", "enum": ["register", "forgot"] }
        }
      },
      "VerifyCodeRequest": {
        "type": "object",
        "required": ["email", "purpose", "code"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "purpose": { "type": "string", "enum": ["register", "forgot"] },
          "code": { "type": "string", "pattern": "^[0-9]{6}$" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "example": "user@example.com" },
          "password": { "type": "string", "example": "password123" }
        }
      },
      "ForgotPasswordRequest": {
        "type": "object",
        "required": ["email", "code"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "code": { "type": "string", "pattern": "^[0-9]{6}$" }
        }
      },
      "ChangePasswordRequest": {
        "type": "object",
        "required": ["currentPassword", "newPassword"],
        "properties": {
          "currentPassword": { "type": "string" },
          "newPassword": { "type": "string", "minLength": 8 }
        }
      },
      "DeleteAccountRequest": {
        "type": "object",
        "required": ["currentPassword"],
        "properties": {
          "currentPassword": { "type": "string" }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "accessToken": { "type": "string" },
          "user": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "email": { "type": "string" }
            }
          }
        }
      },
      "AuthSessionResponse": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "email": { "type": "string" }
            }
          }
        }
      },
      "TripResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "ownerId": { "type": "string" },
          "title": { "type": "string" },
          "startDate": { "type": "string", "example": "2026-06-27" },
          "endDate": { "type": "string", "example": "2026-06-30" },
          "travelers": { "type": "array", "items": { "type": "string" } },
          "destinationCountry": { "type": "string", "pattern": "^[A-Z]{2}$", "example": "CN" },
          "memo": { "type": "string" }
        }
      },
      "PublicTripResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "startDate": { "type": "string", "example": "2026-06-27" },
          "endDate": { "type": "string", "example": "2026-06-30" },
          "travelers": { "type": "array", "items": { "type": "string" } }
        }
      },
      "CreateTripRequest": {
        "type": "object",
        "required": ["title", "startDate", "endDate"],
        "properties": {
          "title": { "type": "string", "example": "나의 여행" },
          "startDate": { "type": "string", "example": "2026-06-27" },
          "endDate": { "type": "string", "example": "2026-06-30" },
          "travelers": { "type": "array", "items": { "type": "string" }, "example": ["여행자 1", "여행자 2"] },
          "destinationCountry": { "type": "string", "pattern": "^[A-Z]{2}$", "default": "JP" },
          "memo": { "type": "string" }
        }
      },
      "UpdateTripRequest": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "startDate": { "type": "string" },
          "endDate": { "type": "string" },
          "travelers": { "type": "array", "items": { "type": "string" } },
          "destinationCountry": { "type": "string", "pattern": "^[A-Z]{2}$" },
          "memo": { "type": "string" }
        }
      },
      "CreateScheduleRequest": {
        "type": "object",
        "required": ["date", "time", "type", "title"],
        "properties": {
          "placeId": { "type": "string" },
          "date": { "type": "string", "example": "2026-06-27" },
          "time": { "type": "string", "example": "10:30" },
          "type": { "type": "string", "example": "sightseeing" },
          "title": { "type": "string", "example": "전망대 방문" },
          "transportMemo": { "type": "string" },
          "guideMemo": { "type": "string" }
        }
      },
      "UpdateScheduleRequest": {
        "type": "object",
        "properties": {
          "placeId": { "type": "string" },
          "date": { "type": "string", "example": "2026-06-27" },
          "time": { "type": "string", "example": "12:00" },
          "type": { "type": "string", "example": "meal" },
          "title": { "type": "string", "example": "점심 식사" },
          "transportMemo": { "type": "string" },
          "guideMemo": { "type": "string" }
        }
      },
      "ScheduleResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "placeId": { "type": "string" },
          "date": { "type": "string" },
          "time": { "type": "string" },
          "type": { "type": "string" },
          "title": { "type": "string" },
          "transportMemo": { "type": "string" },
          "guideMemo": { "type": "string" }
        }
      },
      "CreatePlaceRequest": {
        "type": "object",
        "required": ["name", "category"],
        "properties": {
          "name": { "type": "string", "example": "공항 렌터카 센터" },
          "category": { "type": "string", "example": "transport" },
          "address": { "type": "string", "example": "공항 1층" },
          "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
          "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
          "googlePlaceId": { "type": "string" },
          "googleMapsUrl": { "type": "string", "example": "https://www.google.com/maps/search/?api=1&query=airport" },
          "recommendedReason": { "type": "string", "example": "도착 후 바로 이동할 장소" }
        }
      },
      "UpdatePlaceRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "공항 렌터카 센터 변경" },
          "category": { "type": "string", "example": "transport" },
          "address": { "type": "string", "example": "공항 2층" },
          "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
          "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
          "googlePlaceId": { "type": "string" },
          "googleMapsUrl": { "type": "string", "example": "https://www.google.com/maps/search/?api=1&query=airport" },
          "recommendedReason": { "type": "string", "example": "도착 후 바로 이동할 장소" }
        }
      },
      "CreateFlightRequest": {
        "type": "object",
        "required": ["direction", "label", "departureAirport", "arrivalAirport", "departureDate", "departureTime"],
        "properties": {
          "direction": { "type": "string", "example": "departure" },
          "label": { "type": "string", "example": "출국 항공편" },
          "airline": { "type": "string", "example": "대한항공" },
          "flightNumber": { "type": "string", "example": "KE123" },
          "departureAirport": { "type": "string", "example": "인천" },
          "arrivalAirport": { "type": "string", "example": "도쿄" },
          "departureDate": { "type": "string", "example": "2026-07-10" },
          "departureTime": { "type": "string", "example": "10:30" },
          "arrivalDate": { "type": "string", "example": "2026-07-10" },
          "arrivalTime": { "type": "string", "example": "12:45" },
          "memo": { "type": "string", "example": "터미널 확인 필요" }
        }
      },
      "UpdateFlightRequest": {
        "type": "object",
        "properties": {
          "direction": { "type": "string", "example": "return" },
          "label": { "type": "string", "example": "입국 항공편" },
          "airline": { "type": "string", "example": "대한항공" },
          "flightNumber": { "type": "string", "example": "KE456" },
          "departureAirport": { "type": "string", "example": "도쿄" },
          "arrivalAirport": { "type": "string", "example": "인천" },
          "departureDate": { "type": "string", "example": "2026-07-13" },
          "departureTime": { "type": "string", "example": "18:30" },
          "arrivalDate": { "type": "string", "example": "2026-07-13" },
          "arrivalTime": { "type": "string", "example": "21:00" },
          "memo": { "type": "string", "example": "도착 터미널 확인" }
        }
      },
      "PlaceResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "address": { "type": "string" },
          "latitude": { "type": "number" },
          "longitude": { "type": "number" },
          "googlePlaceId": { "type": "string" },
          "googleMapsUrl": { "type": "string" },
          "recommendedReason": { "type": "string" }
        }
      },
      "FlightResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "direction": { "type": "string" },
          "label": { "type": "string" },
          "airline": { "type": "string" },
          "flightNumber": { "type": "string" },
          "departureAirport": { "type": "string" },
          "arrivalAirport": { "type": "string" },
          "departureDate": { "type": "string" },
          "departureTime": { "type": "string" },
          "arrivalDate": { "type": "string" },
          "arrivalTime": { "type": "string" },
          "memo": { "type": "string" }
        }
      },
      "ShareLinkResponse": {
        "type": "object",
        "properties": {
          "token": { "type": "string" },
          "apiPath": { "type": "string", "example": "/api/share/share-token" },
          "webPath": { "type": "string", "example": "/share/share-token" },
          "expiresAt": { "type": "string" }
        }
      },
      "SharedTripResponse": {
        "type": "object",
        "properties": {
          "trip": { "$ref": "#/components/schemas/PublicTripResponse" },
          "schedules": { "type": "array", "items": { "type": "object" } },
          "places": { "type": "array", "items": { "type": "object" } },
          "flights": { "type": "array", "items": { "$ref": "#/components/schemas/FlightResponse" } },
          "routes": { "type": "array", "items": { "type": "object" } },
          "checklist": { "type": "array", "items": { "$ref": "#/components/schemas/ChecklistItemResponse" } }
        }
      },
      "ChecklistItemResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "category": { "type": "string", "enum": ["before", "airport", "daily", "return"] },
          "title": { "type": "string" },
          "isCompleted": { "type": "boolean" },
          "custom": { "type": "boolean" },
          "destinationCountry": { "type": "string" },
          "scheduledDate": { "type": "string", "format": "date" }
        }
      },
      "CreateChecklistItemRequest": {
        "type": "object",
        "required": ["category", "title"],
        "properties": {
          "category": { "type": "string", "enum": ["before", "airport", "daily", "return"] },
          "title": { "type": "string", "maxLength": 120 },
          "scheduledDate": { "type": "string", "format": "date" }
        }
      },
      "UpdateChecklistItemRequest": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "maxLength": 120 },
          "isCompleted": { "type": "boolean" },
          "scheduledDate": { "type": "string" }
        }
      },
      "PlaceSearchResult": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "address": { "type": "string" },
          "latitude": { "type": "number" },
          "longitude": { "type": "number" },
          "googlePlaceId": { "type": "string" },
          "chineseName": { "type": "string" },
          "chineseAddress": { "type": "string" },
          "subwayExit": { "type": "string" },
          "taxiPhrase": { "type": "string" }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string" }
        }
      }
    }
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "API 프로세스 생존 확인",
        "tags": ["헬스"],
        "responses": {
          "200": { "description": "정상" }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "API 서비스 준비 상태 확인",
        "description": "API 프로세스와 데이터베이스가 요청을 처리할 수 있는지 확인합니다.",
        "tags": ["헬스"],
        "responses": {
          "200": { "description": "서비스 준비 완료" },
          "503": { "description": "데이터베이스 등 필수 의존성 사용 불가" }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "summary": "회원가입",
        "tags": ["인증"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegisterRequest" } } }
        },
        "responses": {
          "201": { "description": "가입 성공", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } } },
          "400": { "description": "입력 오류", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "409": { "description": "이미 사용 중인 이메일", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/auth/send-verification-code": {
      "post": {
        "summary": "이메일 인증코드 발송",
        "tags": ["인증"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SendVerificationCodeRequest" } } }
        },
        "responses": {
          "200": { "description": "발송 성공" },
          "400": { "description": "입력 오류" },
          "409": { "description": "이미 등록된 이메일" },
          "429": { "description": "일일 발송 한도 초과" },
          "502": { "description": "메일 발송 실패" }
        }
      }
    },
    "/api/auth/verify-code": {
      "post": {
        "summary": "이메일 인증코드 사전 확인",
        "tags": ["인증"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VerifyCodeRequest" } } }
        },
        "responses": {
          "200": { "description": "확인 성공" },
          "400": { "description": "코드 불일치 또는 만료" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "로그인",
        "tags": ["인증"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } }
        },
        "responses": {
          "200": { "description": "로그인 성공", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } } },
          "401": { "description": "인증 실패", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "summary": "현재 로그인 사용자 확인",
        "tags": ["인증"],
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "responses": {
          "200": { "description": "현재 사용자", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthSessionResponse" } } } },
          "401": { "description": "인증 필요", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "summary": "브라우저 세션 종료",
        "tags": ["인증"],
        "responses": {
          "204": { "description": "로그아웃 성공 및 세션 쿠키 삭제" }
        }
      }
    },
    "/api/auth/forgot-password": {
      "post": {
        "summary": "인증코드로 임시 비밀번호 발급",
        "tags": ["인증"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ForgotPasswordRequest" } } }
        },
        "responses": {
          "200": { "description": "임시 비밀번호 발급 성공" },
          "400": { "description": "코드 불일치, 만료 또는 가입되지 않은 이메일" }
        }
      }
    },
    "/api/auth/change-password": {
      "post": {
        "summary": "비밀번호 변경 및 새 세션 발급",
        "tags": ["인증"],
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChangePasswordRequest" } } }
        },
        "responses": {
          "200": { "description": "변경 성공", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } } },
          "400": { "description": "현재 비밀번호 불일치 또는 새 비밀번호 규칙 위반" },
          "401": { "description": "인증 필요" }
        }
      }
    },
    "/api/auth/account": {
      "delete": {
        "summary": "내 계정과 연결 데이터 영구 삭제",
        "tags": ["인증"],
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeleteAccountRequest" } } }
        },
        "responses": {
          "204": { "description": "삭제 성공" },
          "400": { "description": "현재 비밀번호 불일치" },
          "401": { "description": "인증 필요" }
        }
      }
    },
    "/api/trips": {
      "get": {
        "summary": "내 여행 목록",
        "tags": ["여행"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "성공", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/TripResponse" } } } } },
          "401": { "description": "인증 필요" }
        }
      },
      "post": {
        "summary": "여행 생성",
        "tags": ["여행"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateTripRequest" } } }
        },
        "responses": {
          "201": { "description": "생성 성공", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TripResponse" } } } },
          "400": { "description": "입력 오류" },
          "401": { "description": "인증 필요" }
        }
      }
    },
    "/api/trips/{tripID}": {
      "parameters": [
        { "name": "tripID", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "get": {
        "summary": "여행 상세 조회",
        "tags": ["여행"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "성공", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TripResponse" } } } },
          "404": { "description": "없음" }
        }
      },
      "patch": {
        "summary": "여행 수정",
        "tags": ["여행"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateTripRequest" } } }
        },
        "responses": {
          "200": { "description": "수정 성공", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TripResponse" } } } },
